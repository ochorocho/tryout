#!/usr/bin/env bash
# The fake `ddev`. `ddev exec` runs the delegated command for real, in the
# project, so a host case covers the container half too — the bash form (one
# shell-quoted string into tryout-container.sh) and the Rust form
# (`--raw -- env … tryout ctr …`) are logged as the same normalised call.
# Everything else (mutagen sync, restart) is only logged.
if [ "${1:-}" = "exec" ]; then
    shift
    if [ "${1:-}" = "--raw" ]; then
        shift; [ "${1:-}" = "--" ] && shift
    else
        eval "set -- $1"
    fi
    args=()
    for a in "$@"; do args+=("${a//\/var\/www\/html/${DDEV_APPROOT}}"); done
    shown="${args[*]}"
    shown="${shown//bash ${DDEV_APPROOT}\/.ddev\/tryout\/tryout-container.sh/<ctr>}"
    shown="${shown//${DDEV_APPROOT}\/.ddev\/tryout\/tryout ctr/<ctr>}"
    echo "ddev exec ${shown}" >> "${FAKE_LOG:?}"
    exec "${args[@]}"
fi
{ printf 'ddev'; printf ' %q' "$@"; printf '\n'; } >> "${FAKE_LOG:?}"
