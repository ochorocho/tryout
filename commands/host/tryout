#!/usr/bin/env bash
#ddev-silent-no-warn
#ddev-generated

## Description: TYPO3 development toolkit — manage Core, patches, and extensions
## Usage: tryout [command] [args]
## Example: "ddev tryout status\nddev tryout download\nddev tryout patch 56947\nddev tryout reset\nddev tryout delete"
## AutocompleteTerms: ["status","download","checkout","composer","patch","worktree","serve","unserve","cs","exec","reset","delete","help"]

set -euo pipefail


source "${DDEV_APPROOT}/.ddev/tryout/functions.sh"

ACTION="${1:-help}"
shift || true

# ─────────────────────────────────────────────────────────────────────
# status — Show project overview
# ─────────────────────────────────────────────────────────────────────
cmd_status() {
    local OK="${GREEN}✓${NC}"
    local WARN="${YELLOW}!${NC}"
    local FAIL="${RED}✗${NC}"

    echo ""
    echo -e "${BOLD}TYPO3 tryout — Status${NC}"
    echo "─────────────────────────────────────"

    # Core repository
    if [ ! -d "${CORE_DIR}/.git" ] && [ ! -f "${CORE_DIR}/.git" ]; then
        echo -e "  Core:      ${FAIL} not cloned"
        echo -e "             ${DIM}→ ddev tryout download${NC}"
        echo "─────────────────────────────────────"
        return
    fi

    local current_branch commit_short commit_date tree_state tree_icon
    current_branch=$(git -C "${CORE_DIR}" branch --show-current 2>/dev/null || echo "detached")
    commit_short=$(git -C "${CORE_DIR}" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    commit_date=$(git -C "${CORE_DIR}" log -1 --format='%cr' 2>/dev/null || echo "")

    if git -C "${CORE_DIR}" diff --quiet 2>/dev/null && git -C "${CORE_DIR}" diff --cached --quiet 2>/dev/null; then
        tree_state="clean"
        tree_icon="${OK}"
    else
        tree_state="dirty"
        tree_icon="${WARN}"
    fi

    echo -e "  Core:      ${tree_icon} ${current_branch} (${commit_short}) — ${tree_state}"
    [ -n "${commit_date}" ] && echo -e "             ${DIM}${commit_date}${NC}"

    # Worktrees (only meaningful once migrated to the symlink layout)
    if core_is_symlinked; then
        local active wt_count
        active=$(active_worktree_name)
        wt_count=$(list_core_worktrees | wc -l | tr -d ' ')
        echo -e "  Worktree:  ${OK} ${active} ${DIM}(${wt_count} total)${NC}"
        list_core_worktrees | while IFS=$'\t' read -r name head branch dirty is_active; do
            [ -n "${is_active}" ] && continue
            echo -e "             ${DIM}${name} — ${branch} (${head})${NC}"
        done
        # Composer binds vendor/ to the resolved real path, so a switch without a
        # rebuild silently keeps serving the previous Core.
        if vendor_core_mismatch; then
            echo -e "             ${WARN} vendor/ was built from a different Core"
            echo -e "             ${DIM}→ ddev tryout worktree use ${active}${NC}"
        fi
    fi

    # Applied patches
    if git -C "${CORE_DIR}" rev-parse "origin/${BRANCH}" >/dev/null 2>&1; then
        local ahead
        ahead=$(git -C "${CORE_DIR}" rev-list --count "origin/${BRANCH}..HEAD" 2>/dev/null || echo "0")
        if [ "${ahead}" -gt 0 ]; then
            echo -e "  Patches:   ${OK} ${ahead} applied"
            git -C "${CORE_DIR}" log --oneline "origin/${BRANCH}..HEAD" 2>/dev/null | head -10 | while IFS= read -r line; do
                echo -e "             ${DIM}${line}${NC}"
            done
        else
            echo -e "  Patches:   ${DIM}none applied${NC}"
        fi
    fi

    # Configured patches
    local patches="${TRYOUT_PATCHES:-}"
    patches=$(echo "${patches}" | tr -d '[:space:]')
    if [ -n "${patches}" ]; then
        echo -e "  Config:    ${CYAN}TRYOUT_PATCHES=${patches}${NC}"
    else
        echo -e "  Config:    ${DIM}no patches configured${NC}"
    fi

    # Custom extensions
    local ext_count
    ext_count=$(find "${PROJECT_ROOT}/packages" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    if [ "${ext_count}" -gt 0 ]; then
        echo -e "  Packages:  ${OK} ${ext_count} custom extension(s)"
        find "${PROJECT_ROOT}/packages" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | while IFS= read -r dir; do
            echo -e "             ${DIM}$(basename "${dir}")${NC}"
        done
    else
        echo -e "  Packages:  ${DIM}none in packages/${NC}"
    fi

    # Composer
    if [ -d "${PROJECT_ROOT}/vendor" ]; then
        echo -e "  Composer:  ${OK} installed"
    else
        echo -e "  Composer:  ${FAIL} not installed"
        echo -e "             ${DIM}→ ddev composer install${NC}"
    fi

    # TYPO3
    if [ -f "${PROJECT_ROOT}/config/system/settings.php" ]; then
        echo -e "  TYPO3:     ${OK} configured"
    else
        echo -e "  TYPO3:     ${FAIL} not set up"
    fi

    # Contribution setup (Gerrit hooks / push URL)
    inspect_contribution_setup
    local cs_parts=()
    [ "${CS_HOOK_COMMIT_MSG}" = "1" ] && cs_parts+=("commit-msg")
    [ "${CS_HOOK_PRE_COMMIT}" = "1" ] && cs_parts+=("pre-commit")
    [ "${CS_TEMPLATE}" = "1" ] && cs_parts+=("template")
    if echo "${CS_PUSH_URL}" | grep -q "^ssh://.*@${GERRIT_SSH_HOST}"; then
        cs_parts+=("push-url")
    fi
    if [ ${#cs_parts[@]} -eq 4 ]; then
        echo -e "  Contrib:   ${OK} ready (${CS_USER:-?})"
    elif [ ${#cs_parts[@]} -gt 0 ]; then
        echo -e "  Contrib:   ${WARN} partial (${cs_parts[*]})"
        echo -e "             ${DIM}→ ddev tryout cs doctor${NC}"
    else
        echo -e "  Contrib:   ${DIM}not configured${NC}"
        echo -e "             ${DIM}→ ddev tryout cs${NC}"
    fi

    # Site URL
    echo -e "  Site:      ${BOLD}${DDEV_PRIMARY_URL}${NC}"
    echo "─────────────────────────────────────"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────
# download — Clone or update TYPO3 Core
# ─────────────────────────────────────────────────────────────────────
cmd_download() {
    local reset=false
    if [ "${1:-}" = "--reset" ] || [ "${1:-}" = "-r" ]; then
        reset=true
    fi

    # First-time clone
    if [ ! -d "${CORE_DIR}" ]; then
        info "Cloning TYPO3 Core (${BRANCH} branch)..."
        info "This may take a few minutes on first run."
        if ! git clone --branch "${BRANCH}" "${CORE_REPO}" "${CORE_DIR}"; then
            error "Failed to clone TYPO3 Core repository"
            exit 1
        fi
        git -C "${CORE_DIR}" remote add gerrit "${GERRIT_REMOTE}"
        success "TYPO3 Core cloned into typo3-core/"
        return
    fi

    ensure_gerrit_remote

    # Reset mode
    if [ "${reset}" = "true" ]; then
        warn "Resetting TYPO3 Core to origin/${BRANCH}..."
        warn "All local changes and applied patches will be lost."
        reset_core_to_main
        success "TYPO3 Core reset to origin/${BRANCH}"
        rebuild_typo3
        return
    fi

    # Update mode
    info "Updating TYPO3 Core..."
    git -C "${CORE_DIR}" fetch origin

    local current_branch
    current_branch=$(git -C "${CORE_DIR}" branch --show-current)
    if [ "${current_branch}" != "${BRANCH}" ]; then
        error "Not on ${BRANCH} branch (currently on: ${current_branch})"
        error "  → Reset: ddev tryout download --reset"
        exit 1
    fi

    if ! git -C "${CORE_DIR}" diff --quiet || ! git -C "${CORE_DIR}" diff --cached --quiet; then
        error "Working tree has uncommitted changes"
        error "  → Reset: ddev tryout download --reset"
        exit 1
    fi

    if ! git -C "${CORE_DIR}" pull --rebase origin "${BRANCH}"; then
        error "Pull failed"
        error "  → Reset: ddev tryout download --reset"
        exit 1
    fi

    success "TYPO3 Core updated to latest origin/${BRANCH}"
    rebuild_typo3
}

# ─────────────────────────────────────────────────────────────────────
# patch — Apply Gerrit patches
# ─────────────────────────────────────────────────────────────────────
cmd_patch() {
    require_core
    ensure_gerrit_remote

    # Optional 2nd arg targets a served site; without it the primary is patched,
    # exactly as before. TRYOUT_SITE_CORE redirects the shared patch helpers at
    # that site's worktree instead of the symlink.
    local site="${2:-${PRIMARY_SITE}}"
    if ! site_is_primary "${site}"; then
        if ! site_is_served "${site}"; then
            error "No served site '${site}'"
            error "  → ddev tryout worktree list"
            return 1
        fi
        CORE_DIR="$(site_core_dir "${site}")"
        BRANCH="$(detect_detached_base_branch)"
        info "Patching site '${site}' ($(basename "${CORE_DIR}"), base ${BRANCH})"
    fi

    if [ -n "${1:-}" ]; then
        apply_patch "$1"
        if [ "${PATCH_RESULT}" = "applied" ]; then
            rebuild_typo3 "${site}"
        fi
    else
        local patches="${TRYOUT_PATCHES:-}"
        patches=$(echo "${patches}" | tr -d '[:space:]')

        if [ -z "${patches}" ]; then
            info "No patches configured."
            echo ""
            echo "Usage:"
            echo "  ddev tryout patch <change-id>   Apply a single Gerrit patch"
            echo "  ddev tryout patch               Apply all from config"
            echo ""
            echo "Configure in .ddev/config.tryout-patches.yaml:"
            echo "  TRYOUT_PATCHES=56947,12345"
            return
        fi

        apply_all_patches
        if [ "${PATCHES_APPLIED:-0}" -gt 0 ]; then
            rebuild_typo3 "${site}"
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────
# reset — Reset Core to latest main and rebuild
# ─────────────────────────────────────────────────────────────────────
cmd_reset() {
    require_core

    local site="${1:-${PRIMARY_SITE}}"
    if ! site_is_primary "${site}"; then
        if ! site_is_served "${site}"; then
            error "No served site '${site}'"
            error "  → ddev tryout worktree list"
            return 1
        fi
        CORE_DIR="$(site_core_dir "${site}")"
        BRANCH="$(detect_detached_base_branch)"
    fi

    echo ""
    info "Resetting $(basename "${CORE_DIR}") to latest origin/${BRANCH}..."
    echo ""

    info "[1/2] Resetting git repository..."
    reset_core_to_main "${site}"
    success "Git reset to origin/${BRANCH}"

    info "[2/2] Rebuilding..."
    rebuild_typo3 "${site}"

    echo ""
    success "Reset complete! Site: $(site_hostname "${site}")"
}

# ─────────────────────────────────────────────────────────────────────
# delete — Wipe database and fileadmin, fresh TYPO3 setup
# ─────────────────────────────────────────────────────────────────────
cmd_delete() {
    local target="${1:-}" sites=()

    # Resolve which site(s) to wipe. Defaulting to the primary keeps existing
    # muscle memory, but with sites served we must name what gets destroyed —
    # silently dropping `db` while orphaning db_<name> is the trap here.
    if [ "${target}" = "--all" ]; then
        sites=("${PRIMARY_SITE}")
        local s
        while IFS= read -r s; do [ -n "${s}" ] && sites+=("${s}"); done < <(served_site_names)
    elif [ -n "${target}" ]; then
        if ! site_is_served "${target}"; then
            error "No served site '${target}'"
            error "  → ddev tryout worktree list"
            return 1
        fi
        sites=("${target}")
    else
        sites=("${PRIMARY_SITE}")
    fi

    echo ""
    echo -e "${YELLOW}${BOLD}Warning:${NC} this destroys data for:"
    local s label
    for s in "${sites[@]}"; do
        label="${s}"
        site_is_primary "${s}" && label="primary"
        echo -e "  ${BOLD}${label}${NC} — database $(site_database "${s}"), $(site_docroot "${s}")/fileadmin, settings.php"
    done
    if [ -z "${target}" ] && [ -n "$(served_site_names)" ]; then
        echo -e "  ${DIM}served sites are untouched — use 'delete <site>' or 'delete --all'${NC}"
    fi
    echo ""
    read -r -p "Are you sure? [y/N] " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        info "Aborted."
        return
    fi

    for s in "${sites[@]}"; do
        echo ""
        label="${s}"; site_is_primary "${s}" && label="primary"
        info "── ${label} ──"
        delete_site "${s}" || return 1
    done

    echo ""
    success "Fresh setup complete!"
    for s in "${sites[@]}"; do
        echo -e "  ${BOLD}$(site_hostname "${s}")/typo3/${NC}"
    done
    echo -e "  ${BOLD}Login:${NC}    admin / Password.1"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────
# checkout — Switch TYPO3 Core branch (version)
# ─────────────────────────────────────────────────────────────────────
cmd_checkout() {
    local target_branch="${1:-}" site="${2:-${PRIMARY_SITE}}"

    if [ -z "${target_branch}" ]; then
        error "Usage: ddev tryout checkout <branch>"
        echo ""
        echo "Examples:"
        echo "  ddev tryout checkout main     # latest development (v14)"
        echo "  ddev tryout checkout 13.4     # v13 LTS"
        echo "  ddev tryout checkout 12.4     # v12 LTS"

        if [ -d "${CORE_DIR}/.git" ]; then
            echo ""
            echo "Available remote branches:"
            git -C "${CORE_DIR}" ls-remote --heads origin 2>/dev/null \
                | awk -F/ '{print "  " $NF}' \
                | sort -V
        fi
        return 1
    fi

    require_core

    if ! site_is_primary "${site}"; then
        if ! site_is_served "${site}"; then
            error "No served site '${site}'"
            error "  → ddev tryout worktree list"
            return 1
        fi
        CORE_DIR="$(site_core_dir "${site}")"
        info "Switching site '${site}' ($(basename "${CORE_DIR}"))"
    fi

    info "Fetching latest branches..."
    git -C "${CORE_DIR}" fetch origin

    # Verify the branch exists on the remote
    if ! git -C "${CORE_DIR}" ls-remote --exit-code --heads origin "${target_branch}" >/dev/null 2>&1; then
        error "Branch '${target_branch}' does not exist on origin"
        echo ""
        echo "Available branches:"
        git -C "${CORE_DIR}" ls-remote --heads origin 2>/dev/null \
            | awk -F/ '{print "  " $NF}' \
            | sort -V
        return 1
    fi

    local current_branch
    current_branch=$(git -C "${CORE_DIR}" branch --show-current 2>/dev/null || echo "detached")

    if [ "${current_branch}" = "${target_branch}" ]; then
        info "Already on ${target_branch}, resetting to latest origin/${target_branch}..."
    else
        info "Switching from ${current_branch} to ${target_branch}..."
    fi

    # git refuses a branch that is checked out in another worktree; point at the
    # non-destructive alternative instead of surfacing the raw git error.
    if core_is_symlinked; then
        local holder
        holder=$(git -C "${CORE_DIR}" worktree list --porcelain 2>/dev/null \
                 | awk -v b="branch refs/heads/${target_branch}" '
                     /^worktree /{w=substr($0,10)} $0==b{print w; exit}')
        if [ -n "${holder}" ] && [ "$(cd "${holder}" && pwd -P)" != "$(cd "${CORE_DIR}" && pwd -P)" ]; then
            error "Branch '${target_branch}' is checked out in $(basename "${holder}")"
            error "  → ddev tryout worktree use ${holder#"${CORE_WORKTREE_PREFIX}"}"
            return 1
        fi
    fi

    # Reset to the target branch
    git -C "${CORE_DIR}" checkout "${target_branch}" 2>/dev/null \
        || git -C "${CORE_DIR}" checkout -b "${target_branch}" "origin/${target_branch}"
    git -C "${CORE_DIR}" reset --hard "origin/${target_branch}"
    git -C "${CORE_DIR}" clean -fd
    rm -rf "${PROJECT_ROOT}/var/cache"/*

    success "Core switched to ${target_branch}"

    # Sync composer.json and rebuild, against this site's own root when serving.
    if site_is_primary "${site}"; then
        cmd_composer
    else
        info "Syncing sites/${site}/composer.tryout.json..."
        ddev exec env PROJECT_ROOT="/var/www/html/sites/${site}" \
            TRYOUT_CORE_DIR="/var/www/html/typo3-core-${site}" \
            php /var/www/html/.ddev/tryout/sync-composer.php
    fi
    rebuild_typo3 "${site}"

    echo ""
    success "Now on TYPO3 branch ${target_branch}"
    echo -e "  ${BOLD}Site:${NC} https://$(site_hostname "${site}")"
}

# ─────────────────────────────────────────────────────────────────────
# composer — Regenerate composer.json from available system extensions
# ─────────────────────────────────────────────────────────────────────
cmd_composer() {
    require_core
    info "Syncing composer.tryout.json with available system extensions..."
    ddev php /var/www/html/.ddev/tryout/sync-composer.php
}

# ─────────────────────────────────────────────────────────────────────
# exec — Run a command in a site's context (its PHP, root and database)
# ─────────────────────────────────────────────────────────────────────
cmd_exec() {
    local site="${1:-}"
    shift || true
    if [ -z "${site}" ] || [ $# -eq 0 ]; then
        error "Usage: ddev tryout exec <site> <command> ..."
        echo ""
        echo "  Examples:"
        echo "    ddev tryout exec v13 vendor/bin/typo3 cache:flush"
        echo "    ddev tryout exec v13 composer show typo3/cms-core"
        echo ""
        echo "  Sites: primary$(served_site_names | sed 's/^/, /' | tr -d '\n')"
        return 1
    fi
    if ! site_is_primary "${site}" && ! site_is_served "${site}"; then
        error "No served site '${site}'"
        error "  → ddev tryout worktree list"
        return 1
    fi
    site_exec "${site}" "$*"
}

# ─────────────────────────────────────────────────────────────────────
# worktree — Manage side-by-side Core checkouts
# ─────────────────────────────────────────────────────────────────────
cmd_worktree() {
    local sub="${1:-list}"
    shift || true

    case "${sub}" in
        add)
            require_core
            local name="${1:-}" branch="" attach="false" serve="false" php=""
            shift || true
            while [ $# -gt 0 ]; do
                case "$1" in
                    --branch)  attach="true" ;;
                    --serve)   serve="true" ;;
                    --php)     php="${2:-}"; shift ;;
                    --php=*)   php="${1#--php=}" ;;
                    *)         branch="$1" ;;
                esac
                shift
            done
            [ -z "${name}" ] && { error "Usage: ddev tryout worktree add <name> [<branch>] [--branch] [--serve] [--php 8.2]"; return 1; }
            # A named PHP version only takes effect on a served site.
            [ -n "${php}" ] && serve="true"
            migrate_core_to_worktree_layout || return 1
            add_core_worktree "${name}" "${branch:-${BRANCH}}" "${attach}" || return 1
            if [ "${serve}" = "true" ]; then
                echo ""
                serve_worktree "${name}" "${php}" || return 1
            else
                echo ""
                echo -e "  ${DIM}→ ddev tryout worktree use ${name}      (switch the primary site)${NC}"
                echo -e "  ${DIM}→ ddev tryout worktree serve ${name}    (give it its own URL)${NC}"
            fi
            ;;

        list)
            require_core
            echo ""
            echo -e "${BOLD}Core worktrees${NC}"
            if ! core_is_symlinked; then
                echo -e "  ${DIM}single Core checkout (no worktrees yet)${NC}"
                echo -e "  ${DIM}→ ddev tryout worktree add <name> [<branch>]${NC}"
                echo ""
                return 0
            fi
            printf "  %-12s %-12s %-12s %-6s %-5s %-10s %s\n" \
                "NAME" "HEAD" "BRANCH" "STATE" "PHP" "DB" "URL"
            list_core_worktrees | while IFS=$'\t' read -r name head branch dirty active; do
                local php="-" db="-" url="" marker=""
                if site_is_served "${name}"; then
                    php=$(site_php_version "${name}")
                    db=$(site_database "${name}")
                    url="https://$(site_hostname "${name}")"
                elif [ -n "${active}" ]; then
                    php="${DDEV_PHP_VERSION:-}"
                    db="db"
                    url="${DDEV_PRIMARY_URL}"
                fi
                [ -n "${active}" ] && marker=" ${GREEN}← primary${NC}"
                printf "  %-12s %-12s %-12s %-6s %-5s %-10s %s" \
                    "${name}" "${head}" "${branch}" "${dirty}" "${php}" "${db}" "${url}"
                echo -e "${marker}"
            done
            echo ""
            echo -e "  ${DIM}served sites have their own URL, PHP and database;${NC}"
            echo -e "  ${DIM}the primary is whichever worktree 'use' points at${NC}"
            echo ""
            ;;

        use)
            require_core
            local name="${1:-}" force="false"
            shift || true
            [ "${1:-}" = "--force" ] && force="true"
            [ -z "${name}" ] && { error "Usage: ddev tryout worktree use <name> [--force]"; return 1; }
            migrate_core_to_worktree_layout || return 1
            use_core_worktree "${name}" "${force}" || return 1
            echo ""
            success "Now on Core '${name}' — ${DDEV_PRIMARY_URL}"
            ;;

        remove|rm)
            require_core
            local name="${1:-}" force="false"
            shift || true
            [ "${1:-}" = "--force" ] && force="true"
            [ -z "${name}" ] && { error "Usage: ddev tryout worktree remove <name> [--force]"; return 1; }
            # A served site owns a tree and a DB; drop those before the worktree.
            if site_is_served "${name}" 2>/dev/null; then
                warn "'${name}' is currently served — removing its site first"
                unserve_worktree "${name}" "false" || return 1
            fi
            remove_core_worktree "${name}" "${force}"
            ;;

        serve)
            require_core
            local name="${1:-}" php=""
            shift || true
            while [ $# -gt 0 ]; do
                case "$1" in
                    --php) php="${2:-}"; shift ;;
                    --php=*) php="${1#--php=}" ;;
                esac
                shift
            done
            [ -z "${name}" ] && { error "Usage: ddev tryout worktree serve <name> [--php 8.2]"; return 1; }
            serve_worktree "${name}" "${php}"
            ;;

        unserve)
            require_core
            local name="${1:-}" keep_db="true"
            shift || true
            [ "${1:-}" = "--drop-db" ] && keep_db="false"
            [ -z "${name}" ] && { error "Usage: ddev tryout worktree unserve <name> [--drop-db]"; return 1; }
            unserve_worktree "${name}" "${keep_db}"
            ;;

        help|-h|--help)
            echo ""
            echo -e "${BOLD}ddev tryout worktree${NC} — side-by-side Core checkouts"
            echo ""
            echo -e "  ${BOLD}add <name> [<branch>]${NC}   Create typo3-core-<name> (detached at origin/<branch>)"
            echo -e "  ${BOLD}list${NC}                    List worktrees and served sites"
            echo -e "  ${BOLD}use <name>${NC}              Point the PRIMARY site at <name>, then rebuild"
            echo -e "  ${BOLD}serve <name>${NC}            Give <name> its own URL, PHP version and database"
            echo -e "  ${BOLD}unserve <name>${NC}          Drop the site, keep the worktree"
            echo -e "  ${BOLD}remove <name>${NC}           Remove a worktree (not the primary)"
            echo ""
            echo "  Flags: --branch    (add: create a real branch, not detached)"
            echo "         --serve     (add: serve it immediately)"
            echo "         --php 8.2   (add/serve: run this site on another PHP version)"
            echo "         --force     (use: switch despite uncommitted changes)"
            echo "                     (remove: discard uncommitted changes)"
            echo "         --drop-db   (unserve: also drop the site's database)"
            echo ""
            echo "  Two ways to run several Cores:"
            echo "    use    — one site at the project URL, switch which Core it serves"
            echo "    serve  — every worktree live at once on <name>.<project>.ddev.site"
            echo ""
            echo "  Adding or removing a served site needs 'ddev restart' so DDEV"
            echo "  registers the hostname and issues its TLS certificate."
            echo ""
            echo "  All worktrees share one git object store, so ddev tryout cs hooks and"
            echo "  Gerrit config are set up once and apply to every one of them."
            echo ""
            ;;

        *)
            error "Unknown worktree command: ${sub}"
            cmd_worktree help
            return 1
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────
# cs — Contribution setup (Gerrit hooks, template, push URL)
# ─────────────────────────────────────────────────────────────────────
cmd_cs() {
    local sub="${1:-setup}"
    shift || true

    case "${sub}" in
        setup)     cmd_cs_setup "$@" ;;
        doctor)    cmd_cs_doctor ;;
        uninstall) cmd_cs_uninstall ;;
        help|-h|--help) cmd_cs_help ;;
        *)
            error "Unknown cs command: ${sub}"
            cmd_cs_help
            return 1
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────
# help — Show available commands
# ─────────────────────────────────────────────────────────────────────
cmd_help() {
    echo ""
    echo -e "${BOLD}ddev tryout${NC} — TYPO3 development toolkit"
    echo ""
    echo "Commands:"
    echo -e "  ${BOLD}status${NC}              Show project overview"
    echo -e "  ${BOLD}download${NC}            Clone or update TYPO3 Core"
    echo -e "  ${BOLD}download --reset${NC}    Hard reset Core to current branch"
    echo -e "  ${BOLD}checkout <branch>${NC}   Switch TYPO3 version (main, 13.4, 12.4, ...)"
    echo -e "  ${BOLD}composer${NC}            Regenerate the Composer overlay from Core sysexts"
    echo -e "  ${BOLD}patch <change-id>${NC}   Apply a Gerrit patch by change ID"
    echo -e "  ${BOLD}exec <site> <cmd>${NC}   Run a command in a site's PHP/root/database"
    echo -e "  ${BOLD}patch${NC}               Apply all patches from config"
    echo -e "  ${BOLD}worktree${NC}            Manage side-by-side Core checkouts"
    echo -e "  ${BOLD}cs [setup|doctor]${NC}   Prepare this instance for Core contribution"
    echo -e "  ${BOLD}reset${NC}               Reset Core to current branch + rebuild"
    echo -e "  ${BOLD}delete [<site>]${NC}     Wipe DB + fileadmin, fresh setup (--all for every site)"
    echo -e "  ${BOLD}help${NC}                Show this help"
    echo ""
    echo "Custom extensions:"
    echo "  Place extensions in packages/ and run:"
    echo "    ddev composer require vendor/my-extension:@dev"
    echo ""
    echo "Gerrit patches (auto-apply on start):"
    echo "  Edit .ddev/config.tryout-patches.yaml:"
    echo "    TRYOUT_PATCHES=56947,12345"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────
# Dispatch
# ─────────────────────────────────────────────────────────────────────
case "${ACTION}" in
    status)   cmd_status "$@" ;;
    download) cmd_download "$@" ;;
    checkout) cmd_checkout "$@" ;;
    composer) cmd_composer "$@" ;;
    patch)    cmd_patch "$@" ;;
    worktree) cmd_worktree "$@" ;;
    cs)       cmd_cs "$@" ;;
    exec)     cmd_exec "$@" ;;
    reset)    cmd_reset "$@" ;;
    delete)   cmd_delete "$@" ;;
    help)     cmd_help ;;
    *)
        error "Unknown command: ${ACTION}"
        cmd_help
        exit 1
        ;;
esac
